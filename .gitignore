/storage/framework/sessions/*
!/storage/framework/sessions/.keep
/storage/framework/views/*
!/storage/framework/views/.keep
/storage/logs/*
!/storage/logs/.keep
/.phpunit.cache/
.phpunit.result.cache

# Editor and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
